rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'bestScore', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Score record validation
    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'playerName', 'score', 'mode', 'difficulty', 'accuracy', 'maxCombo', 'molesHit']) &&
             data.keys().hasOnly(['userId', 'playerName', 'userEmail', 'score', 'mode', 'difficulty', 'accuracy', 'maxCombo', 'molesHit', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 100 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
             data.score is number && data.score >= 0 &&
             data.mode in ['TIME_ATTACK', 'SURVIVAL', 'FRENZY'] &&
             data.difficulty in ['EASY', 'MEDIUM', 'HARD'] &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.maxCombo is number && data.maxCombo >= 0 &&
             data.molesHit is number && data.molesHit >= 0 &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Scores collection (Leaderboard)
    match /scores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) && isValidScore(incoming());
      allow update: if false; // Scores are immutable records
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
