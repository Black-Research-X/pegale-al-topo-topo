{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de jugador autenticado con Google",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID de Firebase Authentication",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Correo de Gmail del jugador",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Nombre visible del jugador",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar de Google del jugador",
          "maxLength": 512
        },
        "bestScore": {
          "type": "number",
          "description": "Mejor puntuación histórica del jugador"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora de creación de la cuenta"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora de última actualización"
        }
      },
      "required": ["userId", "email", "displayName"]
    },
    "Score": {
      "title": "Score",
      "description": "Registro de partida en la tabla de récords arcade",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID del jugador que anotó la puntuación",
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "description": "Nombre o alias del jugador",
          "maxLength": 100
        },
        "userEmail": {
          "type": "string",
          "description": "Email de Gmail del jugador",
          "maxLength": 256
        },
        "score": {
          "type": "number",
          "description": "Puntuación final obtenida"
        },
        "mode": {
          "type": "string",
          "description": "Modo de juego jugado",
          "enum": ["TIME_ATTACK", "SURVIVAL", "FRENZY"]
        },
        "difficulty": {
          "type": "string",
          "description": "Dificultad de la partida",
          "enum": ["EASY", "MEDIUM", "HARD"]
        },
        "accuracy": {
          "type": "number",
          "description": "Porcentaje de precisión de golpes (0-100)"
        },
        "maxCombo": {
          "type": "number",
          "description": "Racha máxima de golpes consecutivos"
        },
        "molesHit": {
          "type": "number",
          "description": "Total de topos noqueados"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Momento en que se registró el récord"
        }
      },
      "required": ["userId", "playerName", "score", "mode", "difficulty", "accuracy", "maxCombo", "molesHit"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Registro de usuario con privilegios de administrador",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "description": "UID del usuario administrador",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Correo del usuario administrador",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Nombre del administrador",
          "maxLength": 100
        },
        "addedBy": {
          "type": "string",
          "description": "UID del administrador que otorgó los permisos",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha en que se otorgaron los permisos"
        }
      },
      "required": ["adminId", "email"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Aviso global enviado por un administrador mediante notificación push a todos los usuarios",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Título breve del aviso push",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Contenido del aviso enviado a los jugadores",
          "maxLength": 500
        },
        "senderUid": {
          "type": "string",
          "description": "UID del administrador que envió el aviso",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Nombre del administrador que envió el aviso",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo del servidor al enviar el aviso"
        }
      },
      "required": ["title", "message", "senderUid", "createdAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Suscripción Web Push VAPID de un navegador o dispositivo para recibir notificaciones en segundo plano",
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "description": "Hash determinístico del endpoint de suscripción",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID del usuario dueño de la suscripción",
          "maxLength": 128
        },
        "endpoint": {
          "type": "string",
          "description": "URL HTTPS del servicio Web Push del navegador",
          "maxLength": 1024
        },
        "p256dh": {
          "type": "string",
          "description": "Clave pública P-256 del cliente para cifrado Web Push",
          "maxLength": 512
        },
        "auth": {
          "type": "string",
          "description": "Secreto de autenticación Web Push del cliente",
          "maxLength": 256
        },
        "userAgent": {
          "type": "string",
          "description": "Identificador resumido del navegador/dispositivo",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de registro o renovación de la suscripción"
        }
      },
      "required": ["subscriptionId", "userId", "endpoint", "p256dh", "auth", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Colección de perfiles de usuario autenticados"
    },
    "/scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/Score"
      },
      "description": "Colección global de puntuaciones arcade registradas por usuarios autenticados"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Colección de usuarios con rol de administrador del sistema"
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "Avisos globales enviados por administradores como notificaciones push"
    },
    "/push_subscriptions/{subscriptionId}": {
      "schema": {
        "$ref": "#/entities/PushSubscription"
      },
      "description": "Suscripciones Web Push VAPID por dispositivo y usuario"
    }
  }
}
