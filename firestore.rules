rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRootAdmin() {
      return isSignedIn() && request.auth.uid == 'H6QC4mER9SZmL58wtY3QHo0Pg6A2';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'H6QC4mER9SZmL58wtY3QHo0Pg6A2' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'bestScore', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Score record validation
    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'playerName', 'score', 'mode', 'difficulty', 'accuracy', 'maxCombo', 'molesHit']) &&
             data.keys().hasOnly(['userId', 'playerName', 'userEmail', 'score', 'mode', 'difficulty', 'accuracy', 'maxCombo', 'molesHit', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 100 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
             data.score is number && data.score >= 0 &&
             data.mode in ['TIME_ATTACK', 'SURVIVAL', 'FRENZY'] &&
             data.difficulty in ['EASY', 'MEDIUM', 'HARD'] &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.maxCombo is number && data.maxCombo >= 0 &&
             data.molesHit is number && data.molesHit >= 0 &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    // Admin entity validation
    function isValidAdmin(data) {
      return data.keys().hasAll(['adminId', 'email']) &&
             data.keys().hasOnly(['adminId', 'email', 'displayName', 'addedBy', 'createdAt']) &&
             data.adminId is string && data.adminId.size() > 0 && data.adminId.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() <= 128)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    // Admin announcement validation
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'senderUid', 'createdAt']) &&
             data.keys().hasOnly(['title', 'message', 'senderUid', 'senderName', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.senderUid is string && data.senderUid == request.auth.uid && data.senderUid.size() <= 128 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100)) &&
             data.createdAt == request.time;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId;
      allow delete: if isAdmin();
    }

    // Scores collection (Leaderboard)
    match /scores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) && isValidScore(incoming());
      allow update: if false; // Scores are immutable records
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow update: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isAdmin() && adminId != 'H6QC4mER9SZmL58wtY3QHo0Pg6A2';
    }

    // Global admin push announcements collection
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow update: if false; // Broadcast announcements are immutable
      allow delete: if isAdmin() && isValidId(announcementId);
    }
  }
}
